ow-api.axl.coach {
	encode zstd gzip
	request_body {
		# SDK batches (~60k records) and Garmin activity files.
		max_size 64MB
	}
	reverse_proxy app:8000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}


project_id = "your-prod-project-id"
region     = "europe-west1"

name_prefix = "open-wearables"

labels = {
  app         = "open-wearables"
  environment = "prod"
  managed_by  = "terraform"
}

artifact_registry_repository_id = "open-wearables-prod"

create_secrets = true
secret_names = [
  "open-wearables-prod-secret-key",
  "open-wearables-prod-db-password",
  "open-wearables-prod-resend-api-key",
  "open-wearables-prod-polar-client-id",
  "open-wearables-prod-polar-client-secret",
]

create_network     = true
create_cloud_sql   = true
create_memorystore = true

enable_backend_api_service    = true
enable_worker_service         = true
enable_backend_init_job       = true
enable_frontend_service       = true
enable_cloud_tasks_dispatch   = false
create_default_scheduler_jobs = true

cloud_sql_db_name     = "open-wearables"
cloud_sql_db_user     = "open_wearables"
cloud_sql_db_password = "replace-me"

backend_image  = "europe-west1-docker.pkg.dev/your-prod-project-id/open-wearables-prod/backend:latest"
frontend_image = "europe-west1-docker.pkg.dev/your-prod-project-id/open-wearables-prod/frontend:latest"

worker_service_base_url = "https://worker.example.run.app"

# Cloud Run container commands.
#
# For ``api`` and ``worker`` we run the FastAPI server module directly
# rather than wrapping in a ``scripts/start/cloud-run-api.sh`` bash
# script — one fewer process layer to debug at startup, and no
# dependency on the script being present in the image (a transient
# ``gcloud builds submit`` tar race silently dropped the two
# ``cloud-run-*.sh`` files on a 2026-05-12 build; the direct command
# is immune).  Worker uses the same direct form, so api/worker stay
# symmetric.
#
# The init job is genuinely multi-step (alembic + provider settings +
# device priorities + admin + series-type seeds) so it keeps the bash
# wrapper.
backend_api_command    = ["/opt/venv/bin/python", "-m", "fastapi", "run", "app/main.py", "--host", "0.0.0.0", "--port", "8000"]
backend_worker_command = ["/opt/venv/bin/python", "-m", "fastapi", "run", "app/main.py", "--host", "0.0.0.0", "--port", "8000"]
backend_init_command   = ["/bin/bash", "scripts/start/cloud-run-init.sh"]

backend_api_env = {
  ENVIRONMENT  = "production"
  CORS_ORIGINS = "https://frontend.example.com"
}

backend_api_secret_env = {
  SECRET_KEY          = { secret = "open-wearables-prod-secret-key" }
  POLAR_CLIENT_ID     = { secret = "open-wearables-prod-polar-client-id" }
  POLAR_CLIENT_SECRET = { secret = "open-wearables-prod-polar-client-secret" }
}

backend_worker_env = {
  ENVIRONMENT = "production"
}

backend_worker_secret_env = {
  SECRET_KEY          = { secret = "open-wearables-prod-secret-key" }
  POLAR_CLIENT_ID     = { secret = "open-wearables-prod-polar-client-id" }
  POLAR_CLIENT_SECRET = { secret = "open-wearables-prod-polar-client-secret" }
}

backend_init_env = {
  ENVIRONMENT = "production"
}

backend_init_secret_env = {
  SECRET_KEY          = { secret = "open-wearables-prod-secret-key" }
  POLAR_CLIENT_ID     = { secret = "open-wearables-prod-polar-client-id" }
  POLAR_CLIENT_SECRET = { secret = "open-wearables-prod-polar-client-secret" }
}

frontend_env = {
  VITE_API_URL = "https://api.example.com"
}

scheduler_jobs = {
  sync-all-users = {
    description                = "Run periodic vendor sync fan-out"
    schedule                   = "0 * * * *"
    time_zone                  = "Etc/UTC"
    target_url                 = "https://worker.example.run.app/tasks/sync-all-users"
    oidc_service_account_email = "open-wearables-prod-scheduler@your-prod-project-id.iam.gserviceaccount.com"
    audience                   = "https://worker.example.run.app"
    headers = {
      Content-Type = "application/json"
    }
    body = "{\"source\":\"cloud-scheduler\"}"
  }
  finalize-stale-sleeps = {
    description                = "Finalize stale sleep sessions"
    schedule                   = "15 * * * *"
    time_zone                  = "Etc/UTC"
    target_url                 = "https://worker.example.run.app/tasks/finalize-stale-sleeps"
    oidc_service_account_email = "open-wearables-prod-scheduler@your-prod-project-id.iam.gserviceaccount.com"
    audience                   = "https://worker.example.run.app"
    headers = {
      Content-Type = "application/json"
    }
    body = "{\"source\":\"cloud-scheduler\"}"
  }
}
